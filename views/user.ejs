<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>userdata</title>
</head>
<body>
    
    <h1>User data</h1>

    <table>
        <tr>
            <th>Id</th>
            <th>Username</th>
            <th>Email</th>
        </tr>
        <tr>
            <%result.forEach((user)=>{%>
               
    
            <td><%=user.id%></td>
            <td><%=user.username%></td>
            <td><%=user.email%></td>
            <td><a href="http://localhost:3000/userdata/<%=user.id%>/edit"><button>Edit</button></a></td>
            <td><a href="http://localhost:3000/userdata/<%=user.id%>/delete"><button>Delete</button></a></td>
        </tr>
        
        <%})%>
    </table>
<a href="http://localhost:3000/newuser"><button>Add user</button></a>
    

</body>
</html>